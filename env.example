# Public Supabase project URL and publishable (or anon) key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical HTTPS origin, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Explicit local demonstration data only; never enable for launch
DEMO_MODE=false
# Set true only after operator details / legal copy are reviewed
LEAD_FORMS_ENABLED=false
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_PHONE=
OPERATOR_EMAIL=
OPERATOR_LICENSE=
OPERATOR_REPRESENTATIVE=
